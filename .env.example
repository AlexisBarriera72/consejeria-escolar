# Copia este archivo a .env.local y llena los valores.
# .env.local está en .gitignore y NUNCA debe subirse al repositorio.

# ── Acceso al panel ─────────────────────────────────────────────────────────
# Genera las dos de golpe con:
#   node scripts/generar-clave.mjs "tu contraseña"
#
# Firma la cookie de sesión. Si cambia, se cierran todas las sesiones.
SESSION_SECRET=

# Huella scrypt de la contraseña. Formato: scrypt:sal:hash
# (dos puntos, no dólar: Next expande el dólar en los .env y parte el valor).
# La contraseña NO se guarda: si se pierde, se genera otra.
ADMIN_PASSWORD_HASH=

# Opcional. Nombre que sale en "Editado por…" y en la franja del panel.
ADMIN_NOMBRE=


# ── Contenido en GitHub (Sección 11) ────────────────────────────────────────
# Token de acceso fino, con permiso de escritura SOLO en este repositorio.
GITHUB_TOKEN=
GITHUB_REPO=usuario/consejeria-escolar
GITHUB_BRANCH=main

# ── Estadísticas (Sección 14) ───────────────────────────────────────────────
# Solo guarda números. Nunca nombres, correos ni direcciones IP.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Calendario de disponibilidad (Sección 15) ───────────────────────────────
# La dirección secreta en formato iCal de un calendario APARTE llamado
# "Disponibilidad" — nunca la del calendario principal de la consejera.
# Esta URL es una contraseña: cualquiera que la tenga ve el calendario.
CALENDARIO_ICS_URL=
