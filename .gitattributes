# Normaliza los finales de línea. Sin esto, cada archivo tocado desde Windows
# aparece como "todo el archivo cambió" en el diff, y los avisos de CRLF
# ensucian cada commit.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
